#!/usr/bin/env bash
# The homework bookkeeper (tools/hw.py). Runs on uv's Python 3.12 when uv is installed; before that,
# on the system python3, which is enough for the setup checks.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for uv in "$(command -v uv)" "$HOME/.local/bin/uv" "$HOME/.cargo/bin/uv"; do
  if [ -n "$uv" ] && [ -x "$uv" ]; then
    exec "$uv" run -q --no-project --python 3.12 "$here/hw.py" "$@"
  fi
done
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$here/hw.py" "$@"
fi
echo "tools/hw needs Python 3 or uv. Install uv with: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
exit 1
